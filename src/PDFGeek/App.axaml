<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PDFGeek.App"
             RequestedThemeVariant="Dark">

  <!-- The control styles used to sit inline here on their own hardcoded palette. They are in
       Themes/Shell.axaml now, reading the house tokens from Themes/Dark.axaml - the same two
       files, with the same token names, that the rest of the range carries. -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PDFGeek/Themes/Shell.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PDFGeek/Themes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
